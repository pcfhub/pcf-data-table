  </data>
  <data name="DataTable_CreateFailed" xml:space="preserve">
    <value>The quick create form could not be opened.</value>
  </data>

  <data name="SelectedRecordIds_Name" xml:space="preserve">
    <value>Selected record IDs</value>
  </data>
  <data name="SelectedRecordIds_Desc" xml:space="preserve">
    <value>The IDs of the currently selected rows, one per line.</value>
  </data>

  <data name="OpenedRecordId_Name" xml:space="preserve">
    <value>Opened record ID</value>
  </data>
  <data name="OpenedRecordId_Desc" xml:space="preserve">
    <value>The ID of the row most recently opened.</value>
  </data>

  <data name="DataTable_Loading" xml:space="preserve">
