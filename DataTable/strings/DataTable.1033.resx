  <!--
    Display names and descriptions for everything declared in
    ControlManifest.Input.xml. PCFHub reads the manifest, so these strings are
    what appear in the component's API reference on the hub as well as in the
    maker's properties pane.

    Copy this file to add a language — DataTable.3082.resx for Spanish, and so
    on — then list it under <resources> in the manifest.
  -->
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>


  <data name="DataTable_Name" xml:space="preserve">
    <value>Data Table</value>
  </data>
  <data name="DataTable_Desc" xml:space="preserve">
    <value>A sortable, filterable table over any Dataverse view, with inline editing and pinned columns.</value>
  </data>

  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Records</value>
  </data>

  <data name="PageSize_Name" xml:space="preserve">
    <value>Page size</value>
  </data>
  <data name="PageSize_Desc" xml:space="preserve">
    <value>How many rows to request per page. The platform may clamp large values.</value>
  </data>

  <data name="PageSizeOptions_Name" xml:space="preserve">
    <value>Rows-per-page choices</value>
  </data>
  <data name="PageSizeOptions_Desc" xml:space="preserve">
    <value>A comma-separated list of page sizes to offer the reader, such as 10,25,50,100. Leave empty for no picker.</value>
  </data>

  <data name="SelectionMode_Name" xml:space="preserve">
    <value>Selection</value>
  </data>
  <data name="SelectionMode_Desc" xml:space="preserve">
    <value>Whether rows can be selected, and whether more than one at a time.</value>
  </data>
  <data name="SelectionMode_None_Name" xml:space="preserve">
    <value>No selection</value>
  </data>
  <data name="SelectionMode_Single_Name" xml:space="preserve">
    <value>Single row</value>
  </data>
  <data name="SelectionMode_Multiple_Name" xml:space="preserve">
    <value>Multiple rows</value>
  </data>

  <data name="EnableSorting_Name" xml:space="preserve">
    <value>Allow sorting</value>
  </data>
  <data name="EnableSorting_Desc" xml:space="preserve">
    <value>Show a sort control on each column the view allows sorting on.</value>
  </data>

  <data name="EnableFiltering_Name" xml:space="preserve">
    <value>Allow filtering</value>
  </data>
  <data name="EnableFiltering_Desc" xml:space="preserve">
    <value>Show a filter box under each column heading that can carry one: text, numbers, dates, and — in a model-driven app — choices. Filtering is applied by the server, across every page.</value>
  </data>

  <data name="EnableExport_Name" xml:space="preserve">
    <value>Allow CSV export</value>
  </data>
  <data name="EnableExport_Desc" xml:space="preserve">
    <value>Show a button that saves the loaded rows as a CSV file. It exports the pages read so far, not the whole view.</value>
  </data>

  <data name="OpenOnRowClick_Name" xml:space="preserve">
    <value>Open on row click</value>
  </data>
  <data name="OpenOnRowClick_Desc" xml:space="preserve">
    <value>Open the record when its row is clicked, as well as from the primary column.</value>
  </data>

  <data name="PinnedStart_Name" xml:space="preserve">
    <value>Pinned columns (start)</value>
  </data>
  <data name="PinnedStart_Desc" xml:space="preserve">
    <value>How many of the view's first columns stay in place while the table scrolls sideways. Leave empty to pin none.</value>
  </data>
  <data name="PinnedEnd_Name" xml:space="preserve">
    <value>Pinned columns (end)</value>
  </data>
  <data name="PinnedEnd_Desc" xml:space="preserve">
    <value>How many of the view's last columns stay in place while the table scrolls sideways. Leave empty to pin none.</value>
  </data>

  <data name="EnableEditing_Name" xml:space="preserve">
    <value>Inline editing</value>
  </data>
  <data name="EnableEditing_Desc" xml:space="preserve">
    <value>Let readers edit a cell in place and save it. Only columns the platform reports as editable for that record are offered.</value>
  </data>
  <data name="EditableColumns_Name" xml:space="preserve">
    <value>Editable columns</value>
  </data>
  <data name="EditableColumns_Desc" xml:space="preserve">
    <value>A comma-separated list of column logical names to limit editing to. Leave empty for every column the platform says is editable. This list can only narrow that, never widen it.</value>
  </data>
  <data name="EditedRecordId_Name" xml:space="preserve">
    <value>Edited record ID</value>
  </data>
  <data name="EditedRecordId_Desc" xml:space="preserve">
    <value>The ID of the row most recently saved by an inline edit.</value>
  </data>
  <data name="EnableCreate_Name" xml:space="preserve">
    <value>Allow adding rows</value>
  </data>
  <data name="EnableCreate_Desc" xml:space="preserve">
    <value>Show a New button that opens the table's quick create form. The table needs quick create enabled and a quick create form. Model-driven apps only.</value>
  </data>
  <data name="CreatedRecordId_Name" xml:space="preserve">
    <value>Created record ID</value>
  </data>
  <data name="CreatedRecordId_Desc" xml:space="preserve">
    <value>The ID of the row most recently added through the New button.</value>
  </data>

  <data name="DataTable_EditCell" xml:space="preserve">
    <value>Edit {0}</value>
  </data>
  <data name="DataTable_EditEmpty" xml:space="preserve">
    <value>(empty)</value>
  </data>
  <data name="DataTable_Saving" xml:space="preserve">
