  </data>

  <data name="DataTable_SortBy" xml:space="preserve">
    <value>Sort by {0}</value>
  </data>
  <data name="DataTable_FilterColumn" xml:space="preserve">
    <value>Filter by {0}</value>
  </data>
  <data name="DataTable_FilterNumberHint" xml:space="preserve">
    <value>Filter by {0}. Type a number, or a comparison such as &gt;1000.</value>
  </data>
  <data name="DataTable_FilterPlaceholder" xml:space="preserve">
