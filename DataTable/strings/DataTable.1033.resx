  </data>
  <data name="EnableMultiSort_Name" xml:space="preserve">
    <value>Allow sorting by several columns</value>
  </data>
  <data name="EnableMultiSort_Desc" xml:space="preserve">
    <value>Shift-click a column heading, or use its add-to-sort control, to order by it after the columns already sorted.</value>
  </data>
  <data name="DataTable_SortRank" xml:space="preserve">
    <value>Sorted by {0}, {1} of {2}</value>
  </data>
  <data name="ExportScope_Name" xml:space="preserve">
    <value>Export covers</value>
  </data>
  <data name="ExportScope_Desc" xml:space="preserve">
    <value>Whether Export CSV writes the rows already loaded, or reads the whole view first. Reading the whole view costs one request per page.</value>
  </data>
  <data name="ExportScope_Loaded" xml:space="preserve">
    <value>The rows loaded so far</value>
  </data>
  <data name="ExportScope_View" xml:space="preserve">
    <value>The whole view</value>
  </data>
  <data name="DataTable_ExportProgress" xml:space="preserve">
