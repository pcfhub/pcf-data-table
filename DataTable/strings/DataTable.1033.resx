  </data>
  <data name="DataTable_SaveTimedOut" xml:space="preserve">
    <value>The platform did not confirm this change. It may not have been saved — reload the form to see the stored value.</value>
  </data>
  <data name="DataTable_NotANumber" xml:space="preserve">
    <value>That is not a number, so nothing was saved.</value>
  </data>
  <data name="DataTable_Yes" xml:space="preserve">
