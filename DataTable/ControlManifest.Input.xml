<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <!--
    The version here is what the Power Platform upgrades on, and the release
    workflow refuses to publish a tag that disagrees with it. Bump this in the
    same commit as the tag.
  -->
  <control namespace="PCFHub"
           constructor="DataTable"
           version="0.6.20"
           display-name-key="DataTable_Name"
           description-key="DataTable_Desc"
           control-type="virtual">

    <external-service-usage enabled="false" />

    <!--
      No property-set roles, deliberately.

      A property-set is a fixed-arity declaration: each one is a named role
      written into the manifest, and there is no way to say "however many
      columns the view has". A role-based table is therefore capped at whatever
      N the manifest hard-codes, and the maker with N+1 columns is stuck.

      The metadata a table needs only exists on real view columns anyway —
      displayName, order, visualSizeFactor, isPrimary, isHidden and
      disableSorting are the maker's own layout decisions, made in the view
      designer, and they arrive on dataset.columns for free. A role cannot
      supply an `order` for a column it does not know about.

      So this control renders whatever the view supplies. See docs/api.md, which
      says so in prose because ::props-table{kind=dataset_column} would render
      an empty table here.
    -->
    <!--
      `cds-data-set-options` restores the subgrid's own chrome: the command bar,
      the view selector and quick find. It is read by the host at design time,
      so it cannot be a runtime property — this is the only place to set it.

      **Model-driven apps only.** A canvas app has no subgrid chrome to show and
      ignores the attribute entirely.

      Turning the command bar on is what makes `setSelectedRecordIds()` visible
      work rather than bookkeeping: the ribbon buttons above the grid act on
      whichever rows the control reports as selected.

      Note the documented options are the whole set — Commandbar, ViewSelector,
      QuickFind — and the manifest schema types this as a plain string, so a
      misspelled option silently does nothing rather than failing the build.
    -->
    <data-set name="records"
              display-name-key="Records_DataSet_Name"
              cds-data-set-options="displayCommandBar:true;displayViewSelector:true;displayQuickFind:true" />

    <!--
      NO `default-value` HERE, AND THAT IS THE DECISION RATHER THAN AN OMISSION.

      **A `default-value` on an optional property is not a default, it is an
      override.** The platform hands the value down whether or not the maker ever
      touched the property, so there is no unset state left to express — and this
      property mirrors something the host has already decided.
      `dataset.paging.pageSize` is the size the host is actually retrieving with:
      on a main grid the user's own *Rows per page* personalisation, on a subgrid
      what the maker set in the form designer, in canvas the platform default.

      `pcf-row-commands` shipped `default-value="25"` and replaced all three on
      every install. Unset, this control adopts what the platform is already doing
      and never calls `setPageSize`; set, it overrides.

      Only the types carrying a null can say this at all — `Whole.None` is
      `number | null`, which is exactly what a `TwoOptions` is not.
    -->
    <property name="pageSize"
              display-name-key="PageSize_Name"
              description-key="PageSize_Desc"
              of-type="Whole.None"
              usage="input"
              required="false" />

    <!--
      A comma-separated list, and NO `default-value` for the same reason
      `pageSize` has none: unset must mean "no picker", so that a control the
      maker has not configured still adopts the host's own paging and calls
      `setPageSize` zero times. A default here would turn that off for everyone.
    -->
    <property name="pageSizeOptions"
              display-name-key="PageSizeOptions_Name"
              description-key="PageSizeOptions_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <property name="selectionMode"
              display-name-key="SelectionMode_Name"
              description-key="SelectionMode_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="single">
      <value name="none" display-name-key="SelectionMode_None_Name">none</value>
      <value name="single" display-name-key="SelectionMode_Single_Name">single</value>
      <value name="multiple" display-name-key="SelectionMode_Multiple_Name">multiple</value>
    </property>

    <property name="enableSorting"
              display-name-key="EnableSorting_Name"
              description-key="EnableSorting_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <!--
      Filtering is server-side, through `dataset.filtering`. That is a property
      of the dataset rather than a capability, so the row itself adds no
      `<feature-usage>`.

      Text and numeric columns get a box; since 0.4.0 a date column gets a date
      box with an On / From / Until toggle, and a Choice column gets a
      dropdown of its options. The dropdown is the one part of the row that
      reads entity metadata, so it is the one part that needs the `Utility`
      feature declared at the bottom of this file — on a host without it the
      column stays unfilterable, as it was. Lookups still get nothing: they
      filter on a GUID that `Column` does not carry, and finding one from a
      typed name is a query this control does not make. See the note in
      `components/resolve.ts`.
    -->
    <property name="enableFiltering"
              display-name-key="EnableFiltering_Name"
              description-key="EnableFiltering_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <!--
      Off by default, and that is the honest half of the feature. The export
      covers the rows the control has loaded rather than the whole view, so a
      maker turns it on having read what it does rather than finding out from a
      colleague's short spreadsheet.

      It needs no `<feature-usage>` either: `navigation.openFile` is a method on
      `context.navigation`, which is not gated, and the fallback is a Blob.
    -->
    <property name="enableExport"
              display-name-key="EnableExport_Name"
              description-key="EnableExport_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <property name="openOnRowClick"
              display-name-key="OpenOnRowClick_Name"
              description-key="OpenOnRowClick_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="true" />

    <!--
      Pinned columns: counts, not names, and no `default-value` on either.

      **Counts, because the view designer is already the configuration UI here.**
      That is the same argument that made this control declare no `property-set`
      roles: the maker arranged the columns and `order` records it, so "the first
      two" is a thing they have already said. A list of logical names would be
      more expressive — it could pin a column out of the middle — and it fails
      silently the day somebody removes that column from the view, which is a
      configuration that quietly stops doing what it says.

      **No default, for the same reason `pageSize` has none:** unset has to mean
      "lay this table out exactly as 0.2.0 did", so a control nobody has
      configured pins nothing and takes none of the layout changes that come with
      it. A default of 1 here would pin the primary column on every existing
      installation at upgrade.

      Both are clamped in `components/resolve.ts` rather than here — a count
      larger than the view has columns, or wide enough to leave nothing to
      scroll, is a number the maker can legitimately type and the control has to
      answer for. See `pinPlan`.
    -->
    <property name="pinnedStart"
              display-name-key="PinnedStart_Name"
              description-key="PinnedStart_Desc"
              of-type="Whole.None"
              usage="input"
              required="false" />

    <property name="pinnedEnd"
              display-name-key="PinnedEnd_Name"
              description-key="PinnedEnd_Desc"
              of-type="Whole.None"
              usage="input"
              required="false" />

    <!--
      Inline editing. Off by default, on the `enableExport` precedent: a
      property that changes what a control *writes* is one a maker turns on
      having read what it does.

      **The write costs no `<uses-feature>`, and that is the whole reason it is
      built this way.** It goes through `record.setValue()` and `record.save()`
      on the dataset record itself — measured on a real subgrid, 2026-09-09,
      value committed and survived a reload; measured again 2026-09-11 for a
      Choice column, integer in and integer read back. The obvious alternative,
      `webAPI.updateRecord`, needs `<uses-feature name="WebAPI" />`, which is an
      install-time permission prompt in every environment, and does nothing at
      all in a canvas app. `pcf-kanban-board` predates the finding and pays it.

      What 0.4.0 added a feature for is not the write but the *editor*: a
      Choice cell needs its option list, `Column` does not carry one, and
      `utils.getEntityMetadata` does. Hence `Utility`, declared at the bottom
      of this file.

      **A Lookup cell is the one exception, since 0.5.0, and it pays the
      price above.** `setValue` on a lookup column stages nothing on this
      host — five shapes tried, 2026-09-11 — so a lookup is picked in the
      platform's own dialog (`utils.lookupObjects`) and written with
      `webAPI.updateRecord` through an `@odata.bind` key, measured 2026-09-13:
      the write persists, `null` clears, and the navigation property the key
      is spelled with is *read* from `EntityDefinitions` rather than derived,
      because on the probe table it was the logical name and a Customer lookup
      has two. Hence `WebAPI`, also at the bottom. Canvas has neither the
      dialog nor the Web API, so lookup cells stay read-only there; every
      other column still writes through the record. SPEC.md 0.5.0.

      Neither record method is in `@types/powerapps-component-framework@1.3.18`
      — `EntityRecord` there declares four methods and none of them writes — so
      both are feature-detected at runtime before anything is offered. See
      `index.ts`.
    -->
    <property name="enableEditing"
              display-name-key="EnableEditing_Name"
              description-key="EnableEditing_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <!--
      A comma-separated allow-list, and NO `default-value` — unset means "every
      column the platform says is editable" rather than "none".

      **It only ever narrows.** The platform is asked `record.isEditable(name)`
      for every cell regardless, and a maker naming a column here does not make
      a read-only column writable. That ordering matters: column-level security
      is invisible on `Column`, so a control that trusted this list alone would
      offer an editor over a column the user cannot write and discover it when
      the save was refused.
    -->
    <property name="editableColumns"
              display-name-key="EditableColumns_Name"
              description-key="EditableColumns_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!--
      A New button. Off by default, on the `enableEditing` precedent: a property
      that makes the control *create* rows is one a maker turns on having read
      what it does.

      **It opens the table's quick create form, and that is the whole design.**
      `DataSet.newRecord` is measured absent on model-driven (SPEC.md 0.3.0), so
      an inline blank row could only reach the server through
      `webAPI.createRecord` — a second feature, a payload that bypasses every
      business rule and required-field check the form would apply, and a row
      that cannot fill a Choice or a Lookup. `navigation.openForm` with
      `useQuickCreateForm: true` is the platform's own create surface, honours
      all of that, and `createFromEntity` from `mode.contextInfo` seeds the
      parent so the row lands in the subgrid it was asked for from — measured
      2026-09-11. Nothing here costs a `<uses-feature>`: `navigation` is a bag
      no feature gates.

      The table needs *Allow quick create* on and a quick create form; what
      `openForm` does without one has not been measured, and SPEC.md lists it
      under *Not verified*. Canvas has no `openForm`, so the button never
      appears there.
    -->
    <property name="enableCreate"
              display-name-key="EnableCreate_Name"
              description-key="EnableCreate_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <!--
      Grouping. Five properties, and the first one being unset is what makes
      0.6.0 render exactly what 0.5.0 rendered.

      Text boxes rather than property-set roles, and grouping is the feature a
      reviewer points at to ask why. Three reasons, the second specific to a
      table:

        1. N group columns is precisely the "however many the view has" arity
           a fixed-arity declaration cannot express. A groupField1/groupField2
           pair caps grouping at two and then the manifest carries two
           configuration languages at once.
        2. **A role is a bound column, and this control renders bound
           columns.** The platform adds a property-set to the query and to
           dataset.columns, so a grouping role would appear as an extra column
           in the table unless the control filtered it out - and filtering it
           out is hidden state the view designer cannot see. pcf-chart-view has
           no such problem because it renders no columns at all.
        3. You group by something the table already shows. The picker buys
           nothing the view designer has not already decided.

      What a role would have bought free is validation, so that is done at
      runtime instead: every name is checked against dataset.columns and a miss
      renders an ungrouped table and names the columns that do exist, in the
      console. See DataTable/group/spec.ts.
    -->
    <!--
      Which rows Export CSV covers.

      "loaded" is the default so that every existing installation exports
      exactly what it exported before. It is also the honest name for what the
      0.5.0 button did, which the docs had to spell out because "Export CSV"
      does not suggest "the pages you happen to have opened".

      "view" loops the whole result set. It is worth having and worth being a
      choice: measured 2026-09-20, setPageSize(250) is honoured, so a view of
      250 rows or fewer is one fetch - but past that it is one round trip per
      page, at a latency nobody has isolated, up to a 10,000 row ceiling. The
      progress counter and the Cancel exist because that cost is real and
      unknown rather than small.
    -->
    <property name="exportScope"
              display-name-key="ExportScope_Name"
              description-key="ExportScope_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="loaded">
      <value name="loaded" display-name-key="ExportScope_Loaded">loaded</value>
      <value name="view" display-name-key="ExportScope_View">view</value>
    </property>

    <property name="groupBy"
              display-name-key="GroupBy_Name"
              description-key="GroupBy_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!--
      Measures, as "sum:revenue, avg:revenue". A count is always included and
      is not written here.

      Refused locally rather than sent, because a refusal is whole-query:
      measured 2026-09-20, sum over a primary key took the group counts down
      with it. One unusable measure must cost its own column, not every row.
    -->
    <property name="aggregates"
              display-name-key="Aggregates_Name"
              description-key="Aggregates_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!--
      There is deliberately no "by option value" here, and that is measured
      rather than aesthetic. Sorting a view by a Choice column puts
      Manufacturing (option value 2) before Retail (option value 1): the
      platform sorts a Choice by its **label**. The aggregate hands the group
      back as the integer, so headers ordered by that integer would read
      Retail, Manufacturing while the rows underneath read Manufacturing,
      Retail - the headers contradicting the rows, on the same column, in the
      same table. A switch whose only effect is that is not a switch worth
      having.
    -->
    <property name="groupSort"
              display-name-key="GroupSort_Name"
              description-key="GroupSort_Desc"
              of-type="Enum"
              usage="input"
              required="false"
              default-value="label">
      <value name="label" display-name-key="GroupSort_Label">label</value>
      <value name="count" display-name-key="GroupSort_Count">count</value>
    </property>

    <!--
      The lookup that points at the record a subgrid sits on, or the literal
      "none" for a subgrid that is not related to it.

      Not optional in the way it looks. Measured 2026-09-20:
      filtering.getFilter() returns null on a subgrid **whether or not** it is
      set to show related records only, so the control cannot see the
      relationship under any configuration. Left unresolved, an aggregate built
      from the view alone counted 56 above a grid holding 38.

      Usually unset is right: the control reads the table's ManyToOne
      relationships and, where exactly one targets the form's table, uses it.
      This is for the case where several do.
    -->
    <!--
      Adding a second column to the sort rather than replacing the first.

      Off by default, and the property exists at all only because the platform
      was measured honouring it: two entries in dataset.sorting reordered the
      rows within the first column's ties, survived paging.reset() and a page
      turn, and four entries were retained with no ceiling found.

      That measurement took two attempts. The first sorted by a column whose
      every value was distinct, so the primary sort never produced a tie and
      the secondary had nothing to break - rows agreeing with the request is
      not evidence the request was honoured. Shipping on that reading would
      have put a rank indicator over an order the platform had quietly
      collapsed, which is a wrong answer that looks completely right.
    -->
    <property name="enableMultiSort"
              display-name-key="EnableMultiSort_Name"
              description-key="EnableMultiSort_Desc"
              of-type="TwoOptions"
              usage="input"
              required="false"
              default-value="false" />

    <property name="parentLookup"
              display-name-key="ParentLookup_Name"
              description-key="ParentLookup_Desc"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!--
      Two outputs rather than one. "Which rows are ticked" and "which row was
      opened" are different questions, and a form reacts to them differently.

      selectedRecordIds is Multiple because a comma-joined list of GUIDs
      overruns SingleLine.Text at about four rows.
    -->
    <property name="selectedRecordIds"
              display-name-key="SelectedRecordIds_Name"
              description-key="SelectedRecordIds_Desc"
              of-type="Multiple"
              usage="output" />

    <property name="openedRecordId"
              display-name-key="OpenedRecordId_Name"
              description-key="OpenedRecordId_Desc"
              of-type="SingleLine.Text"
              usage="output" />

    <!--
      A third output on the same argument as the first two: "which row was
      edited" is a different question from "which row was opened", and a form
      reacts to it differently.

      One id rather than a list of pending changes. The approved plan carried a
      `pendingChanges` output as the canvas escape hatch, on the assumption that
      canvas could not write — the measurement removed the assumption, and an
      output nothing needs is a permanent API surface that cannot be taken back.
    -->
    <property name="editedRecordId"
              display-name-key="EditedRecordId_Name"
              description-key="EditedRecordId_Desc"
              of-type="SingleLine.Text"
              usage="output" />

    <!--
      A fourth output, on the argument the third made: "which row was created"
      is a different question from "which row was edited". Unbraced lower-case
      like the other three — `openForm` resolves a braced upper-case GUID, and
      the control normalises it rather than handing a form two spellings.
    -->
    <property name="createdRecordId"
              display-name-key="CreatedRecordId_Name"
              description-key="CreatedRecordId_Desc"
              of-type="SingleLine.Text"
              usage="output" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/DataTable.css" order="1" />
      <resx path="strings/DataTable.1033.resx" version="1.0.0" />
      <resx path="strings/DataTable.1031.resx" version="1.0.0" />
      <resx path="strings/DataTable.1036.resx" version="1.0.0" />
      <resx path="strings/DataTable.1041.resx" version="1.0.0" />
      <resx path="strings/DataTable.3082.resx" version="1.0.0" />
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
    </resources>

    <!--
      The control's first declared feature, taken in 0.4.0 for entity metadata:
      the option list a Choice column's editor and filter box are built from.
      Every uses-feature entry is an install-time permission prompt for the
      maker; 0.2.0 and 0.3.0 declined this one because it bought a single
      filter box. It now buys an editor and two boxes. It was specified to buy
      a Lookup editor through utils.lookupObjects as well, and the probe took
      that back — the dialog works, the write does not — so the trade is
      thinner than planned and still positive. required="false" so a host
      without the surface leaves it absent rather than refusing to load.
      navigation.openForm is on a bag no feature gates. See SPEC.md 0.4.0.

      The second, WebAPI, is what 0.5.0 took the Lookup editor back with. It
      buys exactly one call — updateRecord, for the one column type the
      dataset record cannot write — and nothing else in this control goes
      through it; text, number, date and choice cells still write through
      record.setValue()/save(), which is the reason 0.3.0 declined this
      feature and the reason it is still not used for them. Declined at
      install, it leaves lookup cells read-only and changes nothing else.
      The relationship metadata the write needs is read with a same-origin
      fetch of EntityDefinitions, which no feature gates. See SPEC.md 0.5.0.
    -->
    <feature-usage>
      <uses-feature name="Utility" required="false" />
      <uses-feature name="WebAPI" required="false" />
    </feature-usage>
  </control>
</manifest>
