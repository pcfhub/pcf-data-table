    "@types/react-dom": "^16.9.24",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "pcf-scripts": "^1",
    "pcf-start": "^1",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "typescript": "^5.3.3"
